# ============================================================
# AgriN Intelligence Network / AgriSaarthi
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets.

# Application Environment
NODE_ENV=development
PORT=5000

# ────────────────────────────────────────────────────────────
# Frontend Configuration
# ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=AgriSaarthi | AgriN Intelligence Network

# ────────────────────────────────────────────────────────────
# Authentication (Local JWT)
# ────────────────────────────────────────────────────────────
JWT_SECRET=agrin_saarthi_super_secure_jwt_secret_dev_key_2026
JWT_EXPIRES_IN=7d

# Google OAuth — backend only (set these in .env, NEVER in frontend)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback (dev)
#                          https://your-backend.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL — used by backend to redirect after Google OAuth
FRONTEND_URL=http://localhost:3000

# VITE_GOOGLE_CLIENT_ID is NOT required for the backend-driven OAuth flow.
# Leave blank unless you are implementing a separate client-side Google flow.
VITE_GOOGLE_CLIENT_ID=

# ────────────────────────────────────────────────────────────
# Database (MongoDB)
# ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/agrin_intelligence_network
# Set to true to use an in-memory store (no MongoDB required for development)
USE_IN_MEMORY_DB=true

# ────────────────────────────────────────────────────────────
# Google AI / Gemini API
# Enables: AI chatbot advisory + crop disease diagnosis (multimodal)
# Leave blank to disable both (chatbot and crop doctor will show "not configured" message)
# Get key at: https://aistudio.google.com/app/apikey
# ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ────────────────────────────────────────────────────────────
# Weather Provider Configuration
# Options: open-meteo (default, free, no key) | weatherapi
# open-meteo: No API key required — live global weather data
# ────────────────────────────────────────────────────────────
WEATHER_PROVIDER=open-meteo
# Only needed if WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# ────────────────────────────────────────────────────────────
# Satellite / NDVI Provider Configuration
# Options: demo (shows "not configured" UI state) | earth-engine
# earth-engine: Requires Google Earth Engine Cloud project + service account
# Without this configured, the satellite page shows an honest "not configured" state
# ────────────────────────────────────────────────────────────
SATELLITE_PROVIDER=demo
# Only needed if SATELLITE_PROVIDER=earth-engine:
EARTH_ENGINE_PROJECT=

# Production (Vercel): Set the full service-account JSON string here.
# Paste the entire content of your service-account key JSON as a single-line value.
# NEVER commit this value to Git. Add to Vercel environment variables dashboard.
EARTH_ENGINE_CREDENTIALS_JSON=

# Local development: Set path to your service-account key JSON file instead.
# Leave blank in production (use EARTH_ENGINE_CREDENTIALS_JSON above).
GOOGLE_APPLICATION_CREDENTIALS=

# ────────────────────────────────────────────────────────────
# Disease Diagnosis Provider
# Options: demo (API not configured msg) | gemini (uses GEMINI_API_KEY above)
# If GEMINI_API_KEY is set, disease diagnosis is automatically enabled.
# ────────────────────────────────────────────────────────────
DISEASE_PROVIDER=gemini

# ────────────────────────────────────────────────────────────
# Storage Provider
# Options: local | cloudinary | gcs
# ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_BUCKET=
UPLOAD_DIR=./uploads

# ────────────────────────────────────────────────────────────
# Localization / i18n
# ────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi
