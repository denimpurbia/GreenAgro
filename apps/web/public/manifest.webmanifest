{
  "name": "GreenAgro — Smarter Farming",
  "short_name": "GreenAgro",
  "description": "AI-powered agricultural intelligence network for small and marginal farmers with real-time weather forecasts, mandi prices, satellite crop health, soil testing, and leaf disease diagnosis.",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f8faf7",
  "theme_color": "#15803d",
  "lang": "hi-IN",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "business"],
